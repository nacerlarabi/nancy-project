    \"<span class=sf-dump-key>promo</span>\" => \"<span class=sf-dump-str title=\"4 characters\">2012</span>\"
  </samp>]
  <span class=sf-dump-index>10</span> => <span class=sf-dump-note>array:8</span> [<samp data-depth=2 class=sf-dump-compact>
    \"<span class=sf-dump-key>id</span>\" => <span class=sf-dump-num>11</span>
    \"<span class=sf-dump-key>firstname</span>\" => \"<span class=sf-dump-str title=\"6 characters\">Jenson</span>\"
    \"<span class=sf-dump-key>lastname</span>\" => <span class=sf-dump-const>null</span>
    \"<span class=sf-dump-key>picture</span>\" => \"<span class=sf-dump-str title=\"26 characters\">/images/testimonies/11.png</span>\"
    \"<span class=sf-dump-key>deposit</span>\" => \"<span class=sf-dump-str title=\"125 characters\">J?ai fait des progr?s en fran?ais. On a eu des cours pour perfectionner notre fran?ais et des cours sur l?histoire de France.</span>\"
    \"<span class=sf-dump-key>occupation</span>\" => \"<span class=sf-dump-str title=\"27 characters\">?tudiant ? Martin-Tennessee</span>\"
    \"<span class=sf-dump-key>country</span>\" => \"<span class=sf-dump-str title=\"3 characters\">USA</span>\"
