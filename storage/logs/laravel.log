    \"<span class=sf-dump-key>deposit</span>\" => \"\"\"
      <span class=sf-dump-str title=\"298 characters\">Merci ? Gilles et ? toute l&#039;?quipe - professeurs et animateurs - pour le plaisir de perfectionner mon fran?ais et de d?couvrir le patrimoine culturel.<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"298 characters\">&lt;br&gt;Un merci sp?cial ? Lih qui est une personne avec un grand coeur, pr?te ? aider et ? soutenir ? tout moment.<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"298 characters\">&lt;br&gt;Courage et bonne continuation !</span>
      \"\"\"
